Options -Indexes
DirectoryIndex index.html

<IfModule mod_autoindex.c>
  IndexIgnore *
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # XAMPP: use http://localhost/... — HTTPS here usually has no valid cert and can leave a blank/black page.
  RewriteCond %{HTTPS} =on
  RewriteCond %{HTTP_HOST} ^(127\.0\.0\.1|localhost)(:\d+)?$ [NC]
  RewriteRule ^ http://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Serve real files (css, js, images, php) as-is.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Serve real asset folders as-is. Do not treat leftover /about or /products folders as assets.
  RewriteCond %{REQUEST_URI} ^/(images|static|backend-php|uploads)(/|$) [NC]
  RewriteRule ^ - [L]

  # SPA routes, including refresh on /about, /products, /careers, even if a leftover folder exists.
  RewriteRule ^ index.html [QSA,L]
</IfModule>

ErrorDocument 404 /index.html

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
